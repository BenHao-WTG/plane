@using Microsoft.AspNetCore.Components

@* Blazor conversion of ConfirmIssueDiscard React component *@

<div class="@(IsOpen ? "fixed" : "hidden") inset-0 z-30 overflow-y-auto">
    <div class="fixed inset-0 bg-custom-backdrop transition-opacity" @onclick="HandleClose"></div>
    
    <div class="my-10 flex items-center justify-center p-4 text-center sm:p-0 md:my-32">
        <div class="relative transform overflow-hidden rounded-lg bg-custom-background-100 text-left shadow-custom-shadow-md transition-all sm:my-8 sm:w-[40rem]">
            <div class="px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                <div class="sm:flex sm:items-start">
                    <div class="mt-3 text-center sm:mt-0 sm:text-left">
                        <h3 class="text-lg font-medium leading-6 text-custom-text-100">
                            Save this draft?
                        </h3>
                        <div class="mt-2">
                            <p class="text-sm text-custom-text-200">
                                You can save this work item to Drafts so you can come back to it later.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="flex justify-between gap-2 p-4 sm:px-6">
                <div>
                    <button class="btn variant-neutral-primary size-sm" @onclick="OnDiscard">
                        Discard
                    </button>
                </div>
                <div class="flex items-center gap-2">
                    <button class="btn variant-neutral-primary size-sm" @onclick="OnClose">
                        Cancel
                    </button>
                    <button class="btn variant-primary size-sm" @onclick="HandleDeletion" disabled="@IsLoading">
                        @(IsLoading ? "Saving" : "Save to Drafts")
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback HandleClose { get; set; }

    [Parameter]
    public EventCallback OnDiscard { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    private bool IsLoading { get; set; }

    private void OnClose()
    {
        HandleClose.InvokeAsync();
        IsLoading = false;
    }

    private async Task HandleDeletion()
    {
        IsLoading = true;
        await OnConfirm.InvokeAsync();
        IsLoading = false;
    }
}
